// ═══════════════════════════════════════════════════════════════════
// Firestore security rules for After12th AI
//
// Copy the entire content of this file into:
//   Firebase Console → Firestore Database → Rules → paste → Publish
//
// These rules ensure a user can only ever read/write their own document.
// No signed-out reads, no cross-user access, no writes to unknown fields.
// ═══════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid}  — the only collection we use today ──────────
    // Each authenticated user reads / writes only their own document.
    match /users/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isValidUserDoc(request.resource.data);
    }

    // ── Any other path → denied by default ────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // Whitelist of top-level fields we actually write from the client.
  // Blocks anyone from stuffing giant blobs or unknown keys into a user doc.
  function isValidUserDoc(data) {
    return data.keys().hasOnly([
      'exam', 'examChosen', 'name', 'email', 'photoURL',
      'scores', 'plan', 'notes', 'streak', 'xp', 'achievements',
      'flashcards', 'settings', 'lastSeen', 'createdAt', 'updatedAt'
    ]);
  }
}
